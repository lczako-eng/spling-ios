# Spling secrets — set via `supabase secrets set`, never commit real values
SQUARE_ACCESS_TOKEN=EAAA...sandbox-token
SQUARE_ENV=sandbox

SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side reads and writes. Never leaves the edge function.
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Used only to start a sign-in and to exchange the code for a user id.
SUPABASE_ANON_KEY=<anon key>

# Local development only. It resolves EVERY caller to one subject, so two people
# using it would share one profile — including one person's allergens. Leave it
# unset anywhere real people can reach.
SPLING_BEARER=generate-with: openssl rand -hex 32
